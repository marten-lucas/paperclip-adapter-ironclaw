{
    "name": "@paperclipai/adapter-ironclaw-http",
    "version": "0.1.8",
    "license": "MIT",
    "description": "Paperclip adapter for Ironclaw AI agent system via HTTP REST API",
    "homepage": "https://github.com/marten-lucas/paperclip-adapter-ironclaw",
    "bugs": {
        "url": "https://github.com/marten-lucas/paperclip-adapter-ironclaw/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/marten-lucas/paperclip-adapter-ironclaw",
        "directory": "ironclaw-http-adapter"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js"
        },
        "./ui": {
            "types": "./dist/ui/index.d.ts",
            "import": "./dist/ui/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./server": {
                "types": "./dist/server/index.d.ts",
                "import": "./dist/server/index.js"
            },
            "./ui": {
                "types": "./dist/ui/index.d.ts",
                "import": "./dist/ui/index.js"
            }
        },
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "test": "npm run clean && npm run build && node --test 'dist/**/*.test.js'",
        "test:ct": "npm run clean && npm run build && node --test 'dist/ct-integration.test.js'",
        "e2e:install": "playwright install --with-deps chromium",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:env": "set -a && . ./.env.e2e && set +a && playwright test",
        "test:e2e:headed:env": "set -a && . ./.env.e2e && set +a && playwright test --headed"
    },
    "dependencies": {
        "@paperclipai/adapter-utils": "^0.3.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.54.2",
        "@types/node": "^24.6.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.3"
    }
}
